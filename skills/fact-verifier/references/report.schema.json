{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fact-verifier:report:0.3",
  "title": "Fact verification report v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methodologyVersion",
    "input",
    "checkedAt",
    "passages",
    "claims",
    "sources",
    "evidence",
    "arguments",
    "audit",
    "limitations",
    "closingSummary",
    "reportId",
    "verificationMode"
  ],
  "properties": {
    "methodologyVersion": {"const": "0.3"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "textScope", "accessStatus", "language"],
      "properties": {
        "mode": {"enum": ["claim", "article"]},
        "textScope": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"], "format": "uri"},
        "accessStatus": {"enum": ["full", "partial", "unavailable"]},
        "language": {"type": "string", "minLength": 1}
      }
    },
    "checkedAt": {"type": "string", "format": "date-time", "minLength": 1},
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "location", "excerpt", "attribution", "claimIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "attribution": {"enum": ["author", "quoted", "denied", "hypothetical", "question", "satire", "uncertain"]},
          "claimIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "normalizedText", "category", "status", "verdict", "confidence", "evidenceIds", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "parentClaimId": {"type": ["string", "null"]},
          "normalizedText": {"type": "string", "minLength": 1},
          "category": {"enum": ["checkable", "opinion", "prediction", "ambiguous", "not_claim"]},
          "status": {"enum": ["checked", "not_checked", "not_checkable"]},
          "verdict": {
            "enum": [
              "supported",
              "mostly_supported",
              "misleading",
              "contradicted",
              "unverified",
              "outdated",
              "not_fact_checkable",
              null
            ]
          },
          "confidence": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["level", "reason"],
            "properties": {"level": {"enum": ["high", "medium", "low"]}, "reason": {"type": "string", "minLength": 1}}
          },
          "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reason": {"type": "string", "minLength": 1},
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["questions", "rounds", "stopReason", "remainingGaps"],
            "properties": {
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text", "status", "evidenceIds", "queryIds"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "text": {"type": "string", "minLength": 1},
                    "status": {"enum": ["resolved", "unresolved"]},
                    "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                    "queryIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
                  }
                },
                "minItems": 1
              },
              "rounds": {"type": "integer", "minimum": 0},
              "stopReason": {
                "enum": [
                  "evidence_sufficient",
                  "budget_exhausted",
                  "source_unavailable",
                  "unresolved_conflict",
                  "tool_unavailable"
                ]
              },
              "remainingGaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0}
            }
          },
          "suggestedCorrection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "reason", "evidenceIds", "changeKind"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "changeKind": {"enum": ["correct", "qualify", "update", "withhold"]}
            }
          },
          "historyMatches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reportId", "claimId", "contextComparison", "action"],
              "properties": {
                "reportId": {"type": "string", "minLength": 1},
                "claimId": {"type": "string", "minLength": 1},
                "contextComparison": {"type": "string", "minLength": 1},
                "action": {"enum": ["reuse_after_recheck", "recheck", "reject"]}
              }
            },
            "minItems": 0
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "checked"}}},
            "then": {"required": ["verification"]},
            "else": {"not": {"anyOf": [{"required": ["verification"]}, {"required": ["suggestedCorrection"]}]}}
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "publisher", "accessStatus", "retrievedAt", "sourceType", "derivedFrom"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": ["string", "null"], "format": "uri"},
          "publisher": {"type": "string", "minLength": 1},
          "author": {"type": ["string", "null"]},
          "publishedAt": {"type": ["string", "null"], "format": "date-time"},
          "retrievedAt": {"type": "string", "format": "date-time", "minLength": 1},
          "accessStatus": {"enum": ["full", "partial", "unavailable"]},
          "sourceType": {"enum": ["primary", "secondary", "social", "database", "unknown"]},
          "derivedFrom": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactPath", "sha256"],
            "properties": {
              "artifactPath": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 1}
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claimId",
          "sourceId",
          "locator",
          "excerptOrSummary",
          "stance",
          "quality",
          "qualityReason",
          "clusterId",
          "independence",
          "contentKind",
          "language",
          "applicability",
          "directness"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claimId": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "excerptOrSummary": {"type": "string", "minLength": 1},
          "stance": {"enum": ["supports", "contradicts", "context", "unclear"]},
          "quality": {"enum": ["high", "medium", "low", "unknown"]},
          "qualityReason": {"type": "string", "minLength": 1},
          "clusterId": {"type": ["string", "null"]},
          "independence": {"enum": ["independent", "derived", "unknown"]},
          "contentKind": {"enum": ["quote", "summary"]},
          "language": {"type": ["string", "null"], "minLength": 1},
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["period", "region", "population"],
            "properties": {
              "period": {"type": ["string", "null"], "minLength": 1},
              "region": {"type": ["string", "null"], "minLength": 1},
              "population": {"type": ["string", "null"], "minLength": 1}
            }
          },
          "directness": {"enum": ["direct", "indirect", "unknown"]}
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "claimId",
          "premises",
          "assumptions",
          "inference",
          "conclusion",
          "type",
          "potentialIssues"
        ],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "claimId": {"type": "string", "minLength": 1},
          "premises": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "inference": {"type": "string", "minLength": 1},
          "conclusion": {"type": "string", "minLength": 1},
          "type": {"enum": ["deductive", "inductive", "abductive", "statistical", "causal", "analogical", "other"]},
          "potentialIssues": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "originTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earliestVisibleSourceId", "caveat"],
      "properties": {"earliestVisibleSourceId": {"type": ["string", "null"]}, "caveat": {"type": "string", "minLength": 1}}
    },
    "articleAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCheckableCount",
        "checkedCount",
        "selectionReason",
        "unexamined",
        "headlineAssessment",
        "summary"
      ],
      "properties": {
        "candidateCheckableCount": {"type": "integer", "minimum": 0},
        "checkedCount": {"type": "integer", "minimum": 0},
        "selectionReason": {"type": "string", "minLength": 1},
        "unexamined": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "headlineAssessment": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onlineChecked", "queries", "finalReview"],
      "properties": {
        "onlineChecked": {"type": "boolean"},
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "purpose", "searchedAt", "id", "claimId", "round", "outcome", "sourceIds"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "purpose": {"enum": ["support", "counter", "neutral", "primary", "origin", "multilingual"]},
              "searchedAt": {"type": "string", "format": "date-time", "minLength": 1},
              "id": {"type": "string", "minLength": 1},
              "claimId": {"type": "string", "minLength": 1},
              "round": {"type": "integer", "minimum": 1},
              "outcome": {"enum": ["success", "no_results", "error"]},
              "sourceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "note": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"outcome": {"enum": ["no_results", "error"]}}},
                "then": {"properties": {"sourceIds": {"maxItems": 0}}}
              },
              {"if": {"properties": {"outcome": {"const": "error"}}}, "then": {"required": ["note"]}}
            ]
          }
        },
        "model": {"type": ["string", "null"], "minLength": 1},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": ["string", "null"], "minLength": 1}
            }
          },
          "minItems": 0
        },
        "finalReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checkedClaimIds", "summaryChecked", "notes"],
          "properties": {
            "status": {"enum": ["complete", "incomplete"]},
            "checkedClaimIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "summaryChecked": {"type": "boolean"},
            "notes": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "persuasionAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "techniques", "communicativeFunction", "limits"],
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "techniques": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "passageId",
              "linguisticCue",
              "technique",
              "possiblePsychologicalMechanism",
              "possibleSharingEffect",
              "relatedClaimIds"
            ],
            "properties": {
              "passageId": {"type": "string", "minLength": 1},
              "linguisticCue": {"type": "string", "minLength": 1},
              "technique": {"type": "string", "minLength": 1},
              "possiblePsychologicalMechanism": {"type": "string", "minLength": 1},
              "possibleSharingEffect": {"type": "string", "minLength": 1},
              "relatedClaimIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          }
        },
        "communicativeFunction": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1}
      }
    },
    "closingSummary": {"type": "string", "minLength": 1},
    "reportId": {"type": "string", "minLength": 1},
    "verificationMode": {"enum": ["quick", "standard", "deep"]},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousReportId", "reason", "changes"],
      "properties": {
        "previousReportId": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "previousVerdict", "newVerdict", "reason", "evidenceIds"],
            "properties": {
              "claimId": {"type": "string", "minLength": 1},
              "previousVerdict": {
                "enum": [
                  "supported",
                  "mostly_supported",
                  "misleading",
                  "contradicted",
                  "unverified",
                  "outdated",
                  "not_fact_checkable",
                  null
                ]
              },
              "newVerdict": {
                "enum": [
                  "supported",
                  "mostly_supported",
                  "misleading",
                  "contradicted",
                  "unverified",
                  "outdated",
                  "not_fact_checkable",
                  null
                ]
              },
              "reason": {"type": "string", "minLength": 1},
              "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          },
          "minItems": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"input": {"properties": {"mode": {"const": "article"}}}}},
      "then": {"required": ["articleAssessment"]}
    },
    {
      "if": {"properties": {"input": {"properties": {"mode": {"const": "claim"}}}}},
      "then": {"not": {"required": ["articleAssessment"]}}
    },
    {
      "properties": {
        "claims": {
          "items": {
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "checked"}}},
                "then": {
                  "properties": {
                    "verdict": {
                      "enum": [
                        "supported",
                        "mostly_supported",
                        "misleading",
                        "contradicted",
                        "unverified",
                        "outdated"
                      ]
                    },
                    "confidence": {"type": "object"}
                  }
                }
              },
              {
                "if": {"properties": {"status": {"const": "not_checked"}}},
                "then": {"properties": {"verdict": {"type": "null"}, "confidence": {"type": "null"}}}
              },
              {
                "if": {"properties": {"status": {"const": "not_checkable"}}},
                "then": {"properties": {"verdict": {"const": "not_fact_checkable"}, "confidence": {"type": "null"}}}
              }
            ]
          }
        }
      }
    }
  ]
}
